# --- Python / tooling caches ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# --- OS / editor cruft ---
.DS_Store
.claude/settings.local.json

# --- Generated outputs ---
# Every assay:* run writes here (artifacts, charts, dashboards, studies). These
# are reproducible from the governed metrics and must not be tracked.
outputs/

# --- Fixtures: the weekly aggregate is committed, the session spine is not ---
# `scripts/generate_fixtures.py --emit both` also writes the session-grain spine
# (~80k rows, ~22 MB). The weekly aggregate is what every metric reads and is
# committed so `git clone && pytest && scripts/demo.py` works with no setup; the
# spine is regenerated on demand by whoever needs it. Both are deterministic from
# the same seed, so nothing is lost by not tracking the large one.
data/assay/sample/cart_checkout_session_spine.csv

# --- Rendered examples: the committed spec stays, its rendered HTML does not ---
plugins/assay/skills/render-chart/examples/out/
plugins/assay/skills/render-dashboard/examples/out/

# --- Local config / registry copies ---
# The governed config that defines the module registry, funnel specs, coverage,
# and guardrails IS tracked — it is the substance of the plugin. What must never
# be tracked is a *local* copy carrying real values: a warehouse project id, live
# wiki page ids, or a personal override. Those use the `.local.yaml` suffix, and
# the tracked counterpart is a `.example.yaml` template.
*.local.yaml
plugins/assay/config/*-registry.yaml
!plugins/assay/config/*-registry.example.yaml
