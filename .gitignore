# --- Python / tooling caches ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# --- OS / editor cruft ---
.DS_Store
.claude/settings.local.json

# --- Generated outputs ---
# Every kattfot:* run writes here (artifacts, charts, dashboards, studies). These
# are reproducible from the governed metrics and must not be tracked.
outputs/

# --- Fixtures: both committed, the spine trimmed to a cohort-week window ---
# `scripts/generate_fixtures.py` writes the weekly aggregate (whole book, small
# because pre-aggregated) and the session-grain spine (one row per cart, ~280
# bytes, so the whole 78-week book is ~22 MB). Both are tracked, because the
# spine-backed skills are unrunnable on a fresh clone without the spine — but
# the committed spine is trimmed to the most recent 19 cohort weeks, the widest
# window any spine skill reads at the funnel spec's own defaults. Regrow the
# full one with `--spine-weeks 0 --out-dir <somewhere-else>`; it is a superset,
# so nothing is lost.

# --- Rendered examples: the committed spec stays, its rendered HTML does not ---
plugins/kattfot/skills/render-chart/examples/out/
plugins/kattfot/skills/render-dashboard/examples/out/

# --- Local config / registry copies ---
# The governed config that defines the module registry, funnel specs, coverage,
# and guardrails IS tracked — it is the substance of the plugin. What must never
# be tracked is a *local* copy carrying real values: a warehouse project id, live
# wiki page ids, or a personal override. Those use the `.local.yaml` suffix, and
# the tracked counterpart is a `.example.yaml` template.
*.local.yaml
plugins/kattfot/config/*-registry.yaml
!plugins/kattfot/config/*-registry.example.yaml
