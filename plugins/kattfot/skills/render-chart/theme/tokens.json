{
  "name": "kattfot-default",
  "description": "Modern, calm analytics theme. Colorblind-safe (Okabe-Ito derived) series palette, generous spacing, light/dark aware. Shared by every chart so the surface looks designed, not assembled.",
  "font": {
    "family": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "mono": "'SF Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "title_size": 20,
    "subtitle_size": 12.5,
    "axis_size": 12,
    "label_size": 12
  },
  "radius": { "card": 16, "pill": 999, "bar": 6 },
  "spacing": { "page": 28, "card": 28 },
  "series_palette": [
    "#2D7DD2", "#E8703A", "#1FA187", "#C45CA8",
    "#E6A100", "#5BB8E6", "#7B61FF", "#444B57"
  ],
  "series_gradient_alpha": 0.16,
  "light": {
    "page_bg": "#F4F6F9",
    "card_bg": "#FFFFFF",
    "card_border": "#E6E9EE",
    "card_shadow": "0 1px 2px rgba(16,24,40,0.04), 0 8px 28px rgba(16,24,40,0.06)",
    "ink": "#0E1116",
    "ink_muted": "#5A6473",
    "ink_faint": "#8A93A2",
    "grid": "#EEF1F5",
    "axis_line": "#D7DCE3",
    "baseline": "#9AA3B2",
    "tooltip_bg": "#0E1116",
    "tooltip_ink": "#FFFFFF"
  },
  "dark": {
    "page_bg": "#0C0F14",
    "card_bg": "#141922",
    "card_border": "#222A36",
    "card_shadow": "0 1px 2px rgba(0,0,0,0.4), 0 12px 36px rgba(0,0,0,0.5)",
    "ink": "#EDEFF3",
    "ink_muted": "#9AA4B2",
    "ink_faint": "#6B7585",
    "grid": "#1E2530",
    "axis_line": "#2A3340",
    "baseline": "#5A6473",
    "tooltip_bg": "#EDEFF3",
    "tooltip_ink": "#0C0F14"
  },
  "tier": {
    "T1": { "label": "T1 · financial/regulatory", "bg": "#FDE8E8", "ink": "#9B1C1C", "dark_bg": "#3A1414", "dark_ink": "#F7B4B4" },
    "T2": { "label": "T2 · governed", "bg": "#E7F2EC", "ink": "#1B6B4C", "dark_bg": "#10271E", "dark_ink": "#7FD6AC" },
    "T3": { "label": "T3 · exploratory", "bg": "#FBF1DD", "ink": "#8A5A00", "dark_bg": "#2E2310", "dark_ink": "#E6B864" }
  },
  "mock": { "ink": "#D14343", "watermark_alpha": 0.10 }
}
