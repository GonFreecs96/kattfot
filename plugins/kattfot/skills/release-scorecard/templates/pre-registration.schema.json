{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/markreid-lab/kattfot/release-scorecard/pre-registration/v1",
  "title": "Release Scorecard pre-registration",
  "description": "Schema for pre-registration.template.yaml in this directory. release-scorecard ships as a documented outline only (see ../SKILL.md) — this schema is complete and could validate an instance today, but nothing in this template calls a validator against it yet.",
  "type": "object",
  "required": [
    "schema_version",
    "release",
    "hypothesis",
    "primary_metric",
    "segment",
    "evaluation",
    "expected_direction"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "release": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "sign_off_owner": { "type": "string" }
      },
      "additionalProperties": false
    },
    "hypothesis": { "type": "string", "minLength": 1 },
    "primary_metric": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "stage_cumulative" },
            "stage": {
              "type": "string",
              "enum": [
                "checkout_started",
                "payment_submitted",
                "payment_decisioned",
                "order_confirmed",
                "shipped",
                "delivered",
                "return_window_complete"
              ]
            }
          },
          "required": ["stage"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "nowcast_target" },
            "target": {
              "type": "string",
              "enum": [
                "start_to_delivered",
                "shipped_to_delivered",
                "start_to_return_window_complete"
              ]
            }
          },
          "required": ["target"],
          "additionalProperties": false
        }
      ]
    },
    "segment": {
      "type": "object",
      "required": ["filters"],
      "properties": {
        "filters": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "control_segment": {
      "type": "object",
      "properties": {
        "filters": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "label": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["launch_date"],
      "properties": {
        "launch_date": { "type": "string", "format": "date" },
        "pre_weeks": { "type": "integer", "minimum": 4, "default": 12 },
        "post_weeks": { "type": "integer", "minimum": 2, "default": 8 },
        "time_range": { "type": "string" }
      },
      "additionalProperties": false
    },
    "nowcast": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "target": {
          "type": "string",
          "enum": [
            "start_to_delivered",
            "shipped_to_delivered",
            "start_to_return_window_complete"
          ]
        }
      },
      "additionalProperties": false
    },
    "expected_direction": {
      "type": "string",
      "enum": ["increase", "decrease", "neutral"]
    }
  },
  "additionalProperties": false
}
